{
  "name": "staticman-reborn",
  "version": "0.0.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "typecheck": "bun run tsc --noEmit",
    "lint": "bun run eslint './**/*.ts' --cache",
    "lint:fix": "bun run eslint './**/*.ts' --cache --fix",
    "fmt": "prettier --check --cache './**/*.{mjs,ts,tsx,js,jsx}'",
    "fmt:fix": "bun fmt --write",
    "prepare": "bun run scripts/prepare.js",
    "build": "bun run scripts/build.ts"
  },
  "dependencies": {
    "@gitbeaker/rest": "^43.8.0",
    "@mswjs/interceptors": "0.45.8",
    "@octokit/rest": "^22.0.1",
    "@types/lodash": "^4.17.26",
    "convict": "^6.2.5",
    "crypto": "^1.0.1",
    "elysia": "^1.4.30",
    "html-escaper": "^3.0.3",
    "install": "^0.13.0",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "object-path": "^0.11.8",
    "slug": "^12.0.1",
    "typescript": "^6",
    "winston": "^3.19.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.3",
    "@types/convict": "^6.1.6",
    "@types/html-escaper": "^3.0.4",
    "@types/node-rsa": "^1.1.4",
    "@types/object-path": "^0.11.4",
    "@types/slug": "^5.0.9",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "axios": "^1.20.0",
    "bun-types": "^1.4.3",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "msw": "^3.0.3",
    "prettier": "^3.9.10"
  },
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "peerDependencies": {
    "typescript": "^7"
  }
}
