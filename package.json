{
  "name": "staticman-reborn",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "typecheck": "bun run tsc --noEmit",
    "lint": "bun run eslint './**/*.ts' --cache",
    "lint:fix": "bun run eslint './**/*.ts' --cache --fix",
    "fmt": "prettier --check --cache './**/*.{mjs,ts,tsx,js,jsx}'",
    "fmt:fix": "bun fmt --write",
    "prepare": "bun run scripts/prepare.js",
    "build": "bun build ./src/index.ts --outfile bundle.js --target bun --minify --no-source-maps"
  },
  "dependencies": {
    "@gitbeaker/rest": "^40.6.0",
    "@octokit/rest": "^22.0.1",
    "@types/lodash": "^4.17.26",
    "convict": "^6.2.5",
    "crypto": "^1.0.1",
    "elysia": "^1.4.30",
    "html-escaper": "^3.0.3",
    "install": "^0.13.0",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "object-path": "^0.11.8",
    "slug": "^9.1.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/convict": "^6.1.6",
    "@types/html-escaper": "^3.0.4",
    "@types/node-rsa": "^1.1.4",
    "@types/object-path": "^0.11.4",
    "@types/slug": "^5.0.9",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "axios": "^1.20.0",
    "bun-types": "^1.4.3",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "msw": "^2.15.0",
    "prettier": "^3.9.10"
  },
  "module": "src/index.js"
}
